{
    "name": "rad-parser",
    "version": "2.0.0",
    "description": "A lightweight, performant, self-contained DICOM parser for Node.js, Bun, Deno, and browsers, built with TypeScript and with zero external dependencies",
    "main": "./dist/package/cjs/index.js",
    "module": "./dist/package/esm/index.js",
    "bin": {
        "rad-parser": "./bin/rad-parser.js"
    },
    "types": "./dist/package/esm/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/package/esm/index.d.ts",
            "import": "./dist/package/esm/index.js",
            "require": "./dist/package/cjs/index.js",
            "default": "./dist/package/esm/index.js"
        },
        "./core": {
            "types": "./dist/package/esm/index-core.d.ts",
            "import": "./dist/package/esm/index-core.js",
            "require": "./dist/package/cjs/index-core.js",
            "default": "./dist/package/esm/index-core.js"
        },
        "./codecs": {
            "types": "./dist/package/esm/index-codecs.d.ts",
            "import": "./dist/package/esm/index-codecs.js",
            "require": "./dist/package/cjs/index-codecs.js",
            "default": "./dist/package/esm/index-codecs.js"
        },
        "./dictionary": {
            "types": "./dist/package/esm/dictionary.d.ts",
            "import": "./dist/package/esm/dictionary.js",
            "require": "./dist/package/cjs/dictionary.js",
            "default": "./dist/package/esm/dictionary.js"
        }
    },
    "type": "module",
    "keywords": [
        "dicom",
        "parser",
        "medical-imaging",
        "radiology",
        "dicom-parser",
        "zero-dependencies",
        "lightweight",
        "typescript",
        "dicom-part10",
        "transfer-syntax",
        "pixel-data"
    ],
    "author": "Alberto Rojas Astorga, RadMedica E.I.R.L.",
    "license": "SEE LICENSE IN LICENSE",
    "private": true,
    "repository": {
        "type": "git",
        "url": "https://github.com/rad-medica/rad-parser.git"
    },
    "bugs": {
        "url": "https://github.com/rad-medica/rad-parser/issues"
    },
    "homepage": "https://github.com/rad-medica/rad-parser#readme",
    "files": [
        "dist/package/**/*",
        "docs/**/*.md",
        "README.md",
        "LICENSE",
        "package.json",
        "bin/**/*"
    ],
    "scripts": {
        "build": "npm run build:package && npm run build:standalone",
        "build:standalone": "tsx scripts/build_standalone.ts",
        "build:package": "tsx scripts/build_package.ts",
        "build:wasm": "tsx scripts/build_wasm_rust.ts",
        "bundle:dictionary": "esbuild src/dictionary-entry.ts --bundle --format=esm --target=es2022 --platform=neutral --outfile=dist/package/dictionary.js --sourcemap --log-level=info",
        "release": "npm run build:wasm && npm run build",
        "type-check": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "benchmark": "tsx benchmarks/benchmark.ts",
        "benchmark:advanced": "tsx benchmarks/benchmark_advanced_features.ts",
        "benchmark:comprehensive": "tsx benchmarks/comprehensive_benchmark.ts",
        "report:comprehensive": "tsx benchmarks/generate_comprehensive_report.ts",
        "benchmark:streaming": "tsx benchmarks/benchmark-streaming.ts",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "lint:md": "markdownlint \"**/*.md\"",
        "lint:md:fix": "markdownlint \"**/*.md\" --fix",
        "format": "prettier --write \"**/*.{ts,js,json,md}\"",
        "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
        "check": "npm run type-check && npm run lint && npm run lint:md && npm run format:check",
        "fix": "npm run lint:fix && npm run lint:md:fix && npm run format",
        "docs:check": "node -e \"for (const f of ['docs/api.md','docs/codec-tutorial.md','docs/utilities.md']) require('fs').accessSync(f)\"",
        "prepublishOnly": "npm run release"
    },
    "engines": {
        "node": ">=22",
        "deno": ">=1.30.0"
    },
    "peerDependencies": {
        "typescript": "^5.0.0"
    },
    "devDependencies": {
        "@cornerstonejs/codec-charls": "^1.2.3",
        "@cornerstonejs/codec-libjpeg-turbo-8bit": "^1.2.2",
        "@cornerstonejs/codec-openjpeg": "^1.3.0",
        "@types/node": "^24.10.2",
        "@vitest/coverage-v8": "^4.0.15",
        "dcmjs": "^0.45.0",
        "dicom-parser": "^1.8.21",
        "efferent-dicom": "^1.3.0",
        "esbuild": "^0.20.0",
        "eslint": "^9.39.2",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.4",
        "markdownlint-cli": "^0.47.0",
        "prettier": "^3.7.4",
        "tsx": "^4.7.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.50.0",
        "vitest": "^4.0.15"
    }
}
