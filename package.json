{
    "name": "rad-parser",
    "version": "2.0.0",
    "description": "A lightweight, performant, self-contained DICOM parser for Node.js, Bun, Deno, and browsers, built with TypeScript and with zero external dependencies",
    "main": "./dist/package/cjs/index.js",
    "module": "./dist/package/esm/index.js",
    "bin": {
        "rad-parser": "./bin/rad-parser.js"
    },
    "types": "./dist/package/esm/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/package/esm/index.d.ts",
            "import": "./dist/package/esm/index.js",
            "require": "./dist/package/cjs/index.js",
            "default": "./dist/package/esm/index.js"
        },
        "./core": {
            "types": "./dist/package/esm/index-core.d.ts",
            "import": "./dist/package/esm/index-core.js",
            "require": "./dist/package/cjs/index-core.js",
            "default": "./dist/package/esm/index-core.js"
        },
        "./codecs": {
            "types": "./dist/package/esm/index-codecs.d.ts",
            "import": "./dist/package/esm/index-codecs.js",
            "require": "./dist/package/cjs/index-codecs.js",
            "default": "./dist/package/esm/index-codecs.js"
        },
        "./dictionary": {
            "types": "./dist/package/esm/dictionary.d.ts",
            "import": "./dist/package/esm/dictionary.js",
            "require": "./dist/package/cjs/dictionary.js",
            "default": "./dist/package/esm/dictionary.js"
        }
    },
    "type": "module",
    "keywords": [
        "dicom",
        "parser",
        "medical-imaging",
        "radiology",
        "dicom-parser",
        "zero-dependencies",
        "lightweight",
        "typescript",
        "dicom-part10",
        "transfer-syntax",
        "pixel-data"
    ],
    "author": "AjRoAs",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/rad-medica/rad-parse.git"
    },
    "bugs": {
        "url": "https://github.com/rad-medica/rad-parse/issues"
    },
    "homepage": "https://github.com/rad-medica/rad-parse#readme",
    "files": [
        "dist/package/**/*",
        "docs/**/*.md",
        "README.md",
        "LICENSE",
        "package.json",
        "bin/**/*"
    ],
    "scripts": {
        "build": "bun run build:package && bun run build:standalone",
        "build:standalone": "bun run scripts/build_standalone.ts",
        "build:package": "bun run scripts/build_package.ts",
        "build:wasm:core": "cd src/zig-core && zig build",
        "build:wasm:codecs": "powershell -ExecutionPolicy Bypass -File src/codecs-wasm/build.ps1",
        "build:wasm": "bun run build:wasm:core && bun run build:wasm:codecs",
        "bundle:dictionary": "bun run esbuild src/dictionary-entry.ts --bundle --format=esm --target=es2022 --platform=neutral --outfile=dist/package/dictionary.js --sourcemap --log-level=info",
        "copy:wasm": "bun run scripts/copy_wasm_package.ts",
        "release": "bun run build:wasm && bun run build && bun run copy:wasm",
        "type-check": "bun run tsc --noEmit",
        "test": "bun run vitest run",
        "test:watch": "bun run vitest",
        "test:coverage": "bun run vitest run --coverage",
        "benchmark": "bun run --bun benchmarks/benchmark.ts",
        "benchmark:advanced": "bun run --bun benchmarks/benchmark_advanced_features.ts",
        "benchmark:comprehensive": "bun run --bun benchmarks/comprehensive_benchmark.ts",
        "report:comprehensive": "bun run --bun benchmarks/generate_comprehensive_report.ts",
        "benchmark:streaming": "bun run --bun benchmarks/benchmark-streaming.ts",
        "lint": "bun run eslint .",
        "lint:fix": "bun run eslint . --fix",
        "lint:md": "bun run markdownlint '**/*.md'",
        "lint:md:fix": "bun run markdownlint '**/*.md' --fix",
        "format": "bun run prettier --write \"**/*.{ts,js,json,md}\"",
        "format:check": "bun run prettier --check \"**/*.{ts,js,json,md}\"",
        "check": "bun run type-check && bun run lint && bun run lint:md && bun run format:check",
        "fix": "bun run lint:fix && bun run lint:md:fix && bun run format",
        "docs:check": "echo 'Checking documentation...' && test -f docs/API.md && test -f docs/CODEC_TUTORIAL.md && test -f docs/UTILITIES.md && echo 'All docs present!'",
        "prepublishOnly": "bun run release"
    },
    "engines": {
        "node": ">=16.0.0",
        "bun": ">=1.0.0",
        "deno": ">=1.30.0"
    },
    "packageManager": "bun@1.1.0",
    "peerDependencies": {
        "typescript": "^5.0.0"
    },
    "devDependencies": {
        "@cornerstonejs/codec-charls": "^1.2.3",
        "@cornerstonejs/codec-libjpeg-turbo-8bit": "^1.2.2",
        "@cornerstonejs/codec-openjpeg": "^1.3.0",
        "@types/node": "^24.10.2",
        "@vitest/coverage-v8": "^4.0.15",
        "binaryen": "^118.0.0",
        "dcmjs": "^0.45.0",
        "dicom-parser": "^1.8.21",
        "efferent-dicom": "^1.3.0",
        "esbuild": "^0.20.0",
        "eslint": "^9.39.2",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.4",
        "markdownlint-cli": "^0.47.0",
        "prettier": "^3.7.4",
        "tsx": "^4.7.0",
        "typescript-eslint": "^8.50.0",
        "vitest": "^4.0.15"
    }
}
