{
    "name": "rad-parser",
    "version": "2.0.0",
    "description": "A lightweight, performant, self-contained DICOM parser for Node.js, Bun, Deno, and browsers, built with TypeScript and with zero external dependencies",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "bin": {
        "rad-parser": "./bin/rad-parser.js"
    },
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs",
            "default": "./dist/index.js"
        },
        "./core": {
            "types": "./dist/index-core.d.ts",
            "import": "./dist/index-core.js",
            "require": "./dist/index-core.cjs",
            "default": "./dist/index-core.js"
        },
        "./codecs": {
            "types": "./dist/index-codecs.d.ts",
            "import": "./dist/index-codecs.js",
            "require": "./dist/index-codecs.cjs",
            "default": "./dist/index-codecs.js"
        },
        "./dictionary": {
            "types": "./dist/dictionary.d.ts",
            "import": "./dist/dictionary.js",
            "require": "./dist/dictionary.cjs",
            "default": "./dist/dictionary.js"
        }
    },
    "type": "module",
    "keywords": [
        "dicom",
        "parser",
        "medical-imaging",
        "radiology",
        "dicom-parser",
        "zero-dependencies",
        "lightweight",
        "typescript",
        "dicom-part10",
        "transfer-syntax",
        "pixel-data"
    ],
    "author": "AjRoAs",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/AjRoAs/rad-parse.git"
    },
    "bugs": {
        "url": "https://github.com/AjRoAs/rad-parse/issues"
    },
    "homepage": "https://github.com/AjRoAs/rad-parse#readme",
    "files": [
        "dist/**/*",
        "docs/**/*.md",
        "src/wasm-core-build/*.wasm",
        "src/wasm-codecs-build/*.wasm",
        "README.md",
        "LICENSE",
        "package.json",
        "bin/**/*"
    ],
    "scripts": {
        "build": "tsc && bun run build:cjs",
        "build:cjs": "esbuild src/index.ts --bundle --format=cjs --platform=node --target=node16 --outfile=dist/index.cjs --log-level=info && esbuild src/index-core.ts --bundle --format=cjs --platform=node --target=node16 --outfile=dist/index-core.cjs --log-level=info && esbuild src/index-codecs.ts --bundle --format=cjs --platform=node --target=node16 --outfile=dist/index-codecs.cjs --log-level=info",
        "build:wasm:core": "cd src/wasm-core && wasm-pack build --target web --out-dir ../wasm-core-build --release",
        "build:wasm:codecs": "cd src/wasm-codecs && wasm-pack build --target web --out-dir ../wasm-codecs-build --release",
        "build:zig-codecs": "cd src/zig-codecs && zig build --release=fast -p zig-out",
        "optimize:zig-codecs": "bun run scripts/optimize_wasm_codecs.mjs",
        "build:wasm": "bun run build:wasm:core && bun run build:wasm:codecs",
        "bundle:full": "esbuild src/index.ts --bundle --format=esm --target=es2022 --platform=neutral --outfile=dist/rad-parser.js --sourcemap --log-level=info --external:env && esbuild src/index.ts --bundle --format=esm --target=es2022 --platform=neutral --outfile=dist/rad-parser.min.js --minify --log-level=info --external:env",
        "bundle:core": "esbuild src/index-core.ts --bundle --format=esm --target=es2022 --platform=neutral --outfile=dist/index-core.js --sourcemap --log-level=info",
        "bundle:codecs": "esbuild src/index-codecs.ts --bundle --format=esm --target=es2022 --platform=neutral --outfile=dist/index-codecs.js --sourcemap --log-level=info --external:env",
        "bundle:dictionary": "esbuild src/dictionary-entry.ts --bundle --format=esm --target=es2022 --platform=neutral --outfile=dist/dictionary.js --sourcemap --log-level=info",
        "bundle:lite": "bun run bundle:core",
        "copy:wasm": "copy src\\wasm-core-build\\*.wasm dist\\ && copy src\\wasm-codecs-build\\*.wasm dist\\",
        "bundle": "bun run bundle:full && bun run bundle:core && bun run bundle:codecs && bun run bundle:lite && bun run bundle:dictionary && bun run copy:wasm",
        "release": "bun run build:wasm && bun run build && bun run bundle",
        "type-check": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "benchmark": "bun run --bun scripts/benchmark.ts",
        "benchmark:advanced": "bun run --bun scripts/benchmark_advanced_features.ts",
        "benchmark:comprehensive": "bun run --bun scripts/comprehensive_benchmark.ts",
        "report:comprehensive": "bun run --bun scripts/generate_comprehensive_report.ts",
        "benchmark:streaming": "bun run --bun scripts/benchmark-streaming.ts",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write \"**/*.{ts,js,json,md}\"",
        "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
        "check": "bun run type-check && bun run lint && bun run format:check",
        "fix": "bun run lint:fix && bun run format",
        "docs:check": "echo 'Checking documentation...' && test -f docs/API.md && test -f docs/CODEC_TUTORIAL.md && test -f docs/UTILITIES.md && echo 'All docs present!'",
        "prepublishOnly": "bun run release"
    },
    "engines": {
        "node": ">=16.0.0",
        "bun": ">=1.0.0",
        "deno": ">=1.30.0"
    },
    "peerDependencies": {
        "typescript": "^5.0.0"
    },
    "devDependencies": {
        "binaryen": "^118.0.0",
        "@cornerstonejs/codec-charls": "^1.2.3",
        "@cornerstonejs/codec-libjpeg-turbo-8bit": "^1.2.2",
        "@cornerstonejs/codec-openjpeg": "^1.3.0",
        "@types/node": "^24.10.2",
        "@vitest/coverage-v8": "^4.0.15",
        "dcmjs": "^0.45.0",
        "dicom-parser": "^1.8.21",
        "efferent-dicom": "^1.3.0",
        "esbuild": "^0.20.0",
        "eslint": "^9.39.2",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.4",
        "prettier": "^3.7.4",
        "tsx": "^4.7.0",
        "typescript-eslint": "^8.50.0",
        "vitest": "^4.0.15"
    }
}
