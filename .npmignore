# NPM Ignore - Files to exclude from npm package

# Source files (only dist is published)
src/
tests/
scripts/

# Config files
tsconfig*.json
.eslintrc*
.prettierrc*
vitest.config.ts

# Development files
.vscode/
.idea/
.git/
.github/
.gitignore
.npmignore

# Test data
test_data/

# Documentation source (keep only compiled docs)
*.todo
*.draft

# Rust/Wasm source (keep only built .wasm files)
src/wasm-core/
src/wasm-codecs/
Cargo.toml
Cargo.lock

# Build artifacts
*.tsbuildinfo
.cache/

# Logs and temp
*.log
*.tmp

# Gemini artifacts
.gemini/

# Results
results/
scripts/results/
benchmark-results.json

# Coverage
coverage/
.nyc_output/
