{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug CLI",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "npx",
            "runtimeArgs": ["tsx"],
            "program": "${workspaceFolder}/src/cli.ts",
            "args": ["dump", "${input:dicomFile}"],
            "console": "integratedTerminal",
            "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Debug tests",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "npx",
            "runtimeArgs": ["vitest", "run"],
            "console": "integratedTerminal",
            "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Debug benchmarks",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "npx",
            "runtimeArgs": ["tsx"],
            "program": "${workspaceFolder}/benchmarks/benchmark.ts",
            "console": "integratedTerminal",
            "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Attach to Node process",
            "type": "node",
            "request": "attach",
            "port": 9229,
            "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
        }
    ],
    "inputs": [
        {
            "id": "dicomFile",
            "type": "promptString",
            "description": "DICOM file to dump"
        }
    ]
}
