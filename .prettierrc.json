{
    "semi": true,
    "trailingComma": "es5",
    "singleQuote": false,
    "printWidth": 80,
    "tabWidth": 4,
    "useTabs": false,
    "endOfLine": "lf",
    "bracketSpacing": true,
    "bracketSameLine": false,
    "arrowParens": "avoid",
    "quoteProps": "as-needed",
    "jsxSingleQuote": false,
    "overrides": [
        {
            "files": "*.md",
            "options": {
                "printWidth": 100,
                "proseWrap": "preserve"
            }
        }
    ]
}
