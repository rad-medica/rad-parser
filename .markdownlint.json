{
    "default": true,
    "MD003": {
        "style": "atx"
    },
    "MD004": {
        "style": "dash"
    },
    "MD007": {
        "indent": 2
    },
    "MD013": {
        "line_length": 120,
        "tables": false,
        "code_blocks": false,
        "headings": false
    },
    "MD024": {
        "allow_different_nesting": true
    },
    "MD025": {
        "level": 1
    },
    "MD026": {
        "punctuation": ".,;:!。？！"
    },
    "MD029": {
        "style": "ordered"
    },
    "MD030": {
        "ul_single": 1,
        "ol_single": 1,
        "ol_multi": 1,
        "ul_multi": 1
    },
    "MD033": {
        "allowed_elements": [
            "br",
            "details",
            "summary",
            "kbd",
            "img"
        ]
    },
    "MD036": false,
    "MD040": false,
    "MD041": false,
    "MD046": {
        "style": "fenced"
    },
    "MD048": {
        "style": "backtick"
    },
    "MD060": false
}
