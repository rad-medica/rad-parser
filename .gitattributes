# Same file in every radspider repository. Text is stored and checked out with LF on every OS;
# only Windows scripts get CRLF. Binaries are never converted.
* text=auto eol=lf

*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

